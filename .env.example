# ---- SMTP settings for the contact form (copy to .env and fill in) ----
# Gmail example: host smtp.gmail.com, port 465, secure true, and an App Password
# (Google Account -> Security -> 2-Step Verification -> App passwords).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=you@example.com
SMTP_PASS=your-app-password

# Where contact-form messages are delivered
MAIL_TO=you@example.com
# "From" shown on outgoing mail (usually the same as SMTP_USER)
MAIL_FROM="Portfolio <you@example.com>"
# Send an automatic "thanks, I got your message" reply to the sender (true/false)
AUTO_REPLY=true

PORT=5000
# Allowed browser origin(s) for the API, comma separated
CORS_ORIGIN=http://localhost:5173

# LeetCode username for the stats section (/api/leetcode)
LEETCODE_USER=priyanshu2068
